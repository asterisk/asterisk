index b4296d36..7c1e4bab 100644
--- a/pjnath/include/pjnath/ice_session.h
+++ b/pjnath/include/pjnath/ice_session.h
@@ -694,6 +694,16 @@ typedef struct pj_ice_sess_options
      */
     pj_bool_t check_src_addr;
 
+    /**
+     * Specify whether the session implements ICE-Lite. An ICE-Lite session
+     * always uses the controlled role, responds to connectivity checks, and
+     * never originates ordinary or triggered connectivity checks. The
+     * application is responsible for supplying host candidates only.
+     *
+     * Default value is PJ_FALSE.
+     */
+    pj_bool_t lite;
+
 } pj_ice_sess_options;
 
 
@@ -1143,4 +1153,3 @@ PJ_END_DECL
 
 
 #endif  /* __PJNATH_ICE_SESSION_H__ */
-
diff --git a/pjnath/src/pjnath/ice_session.c b/pjnath/src/pjnath/ice_session.c
index e1513b94..98226431 100644
--- a/pjnath/src/pjnath/ice_session.c
+++ b/pjnath/src/pjnath/ice_session.c
@@ -326,6 +326,7 @@ PJ_DEF(void) pj_ice_sess_options_default(pj_ice_sess_options *opt)
         ICE_CONTROLLED_AGENT_WAIT_NOMINATION_TIMEOUT;
     opt->trickle = PJ_ICE_SESS_TRICKLE_DISABLED;
     opt->check_src_addr = PJ_ICE_SESS_CHECK_SRC_ADDR;
